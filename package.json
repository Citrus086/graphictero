{
  "name": "graphictero",
  "version": "0.0.1",
  "description": "Graphictero - personal paper relationship graph app",
  "main": "out/main/index.js",
  "author": "Citrus086",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-electron-dist.mjs --runtime && electron-vite dev",
    "dev:isolated": "node scripts/check-electron-dist.mjs --runtime && node scripts/dev-isolated.mjs",
    "dev:isolated:tmp": "node scripts/check-electron-dist.mjs --runtime && node scripts/dev-isolated.mjs --tmp",
    "build": "node scripts/check-electron-dist.mjs --runtime && pnpm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite preview",
    "postinstall": "node scripts/rebuild-better-sqlite3-electron.mjs && node scripts/prepare-better-sqlite3-node.mjs && node scripts/check-electron-dist.mjs --runtime --fix",
    "fix:electron-dist": "node scripts/check-electron-dist.mjs --runtime --fix",
    "test": "node scripts/prepare-better-sqlite3-node.mjs && vitest run",
    "pack:mac": "electron-builder --mac --arm64",
    "probe:fts5": "node scripts/probe-fts5.mjs ./node_modules/.bin/electron probes/results/fts5-probe-dev.json",
    "smoke:ui": "node scripts/run-ui-smoke.mjs --build",
    "smoke:mineru": "vitest run --config vitest.smoke.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.73",
    "@embedpdf/core": "2.15.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-render": "2.15.1",
    "@embedpdf/plugin-scroll": "2.15.1",
    "@embedpdf/plugin-viewport": "2.15.1",
    "@embedpdf/plugin-zoom": "2.15.1",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.153",
    "better-sqlite3": "^12.2.0",
    "echarts": "6.1.0",
    "elkjs": "^0.12.0",
    "katex": "0.19.1",
    "mermaid": "12.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "dagre": "^0.8.5",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "jsdom": "30.1.3",
    "node-gyp": "^13.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  }
}
